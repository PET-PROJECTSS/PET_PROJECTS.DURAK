# Токен бота из @BotFather
BOT_TOKEN=your_bot_token_from_botfather
# USE_PROXY=1 включай только если api.telegram.org недоступен напрямую
# и у тебя есть настоящий HTTP(S)-прокси. HTTP_PROXY не может указывать на MTProto-порт.
USE_PROXY=0
HTTP_PROXY=
APP_HOST=0.0.0.0
APP_PORT=8080
# Публичный https-URL (обязателен для Telegram Web App и кнопки меню).
# На деве без https оставь http://127.0.0.1:8080 — кнопка Mini App просто не покажется.
APP_URL=https://durak.example.com
GUEST_ALLOWED=1
